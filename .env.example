DATABASE_URL=

# Cloudflare R2 — for product image uploads
# R2_ACCOUNT_ID: from Cloudflare dashboard → R2 → Manage R2 API Tokens
# R2_ACCESS_KEY_ID + R2_SECRET_ACCESS_KEY: create an R2 API Token with Object Read & Write
# R2_BUCKET_NAME: the bucket name you created in R2
# R2_PUBLIC_URL: enable "Public access" on the bucket → copy the public URL (no trailing slash)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required to enable the protected dashboard at /dashboard
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=

# Set to "true" to open /dashboard without a database or login (client preview only)
PREVIEW_MODE=
